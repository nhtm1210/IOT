# =====================================================================
# CẤU HÌNH HỆ THỐNG BACKEND SMART HOME IoT AI
# =====================================================================

# 1. Server & Môi trường
APP_NAME="Smart Home IoT AI Backend"
APP_VERSION="1.1.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=true

# 2. Bảo mật & JWT Authentication
JWT_SECRET_KEY="smarthome_iot_super_secret_key_change_in_production_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Cơ sở dữ liệu (SQLite mặc định, có thể đổi sang PostgreSQL/MySQL)
DATABASE_URL="sqlite:///./data/smarthome.db"

# 4. Cấu hình MQTT Broker
MQTT_HOST="127.0.0.1"
MQTT_PORT=1883
MQTT_USERNAME=""
MQTT_PASSWORD=""
ENABLE_EMBEDDED_BROKER=true

# 5. Nhận diện khuôn mặt AI & Bảo mật ESP32-CAM
FACE_MATCH_THRESHOLD=0.65
DEVICE_API_KEY=""

# 6. Cảnh báo Telegram Bot (Tùy chọn - điền để bật gửi tin nhắn cảnh báo)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 7. Đường dẫn đóng gói gộp Frontend (nếu đã chạy npm run build ở ../frontend/dist)
SERVE_FRONTEND_DIST=true
FRONTEND_DIST_DIR="../frontend/dist"
